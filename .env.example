# Mot de passe de l'espace administrateur
ADMIN_PASSWORD=changez-moi

# Secret de signature des sessions (32 caractères minimum)
SESSION_SECRET=changez-ce-secret-de-session-32-caracteres-minimum

# Chemin du fichier SQLite (volume Docker)
DATABASE_PATH=/data/app.db

# Nombre de groupes par défaut à la création
NUM_GROUPS=10
